# Supabase (obligatorio) — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferimos la "publishable key" (API Keys nueva).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Compatibilidad (en caso de keys viejas).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional — integraciones reales
# MERCADOPAGO_ACCESS_TOKEN=
# RESEND_API_KEY=
